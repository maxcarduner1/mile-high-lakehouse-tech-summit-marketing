# Dependencies — regenerated by `npm install`/`npm ci` from the committed
# package-lock.json (start.sh + scripts/build-app.sh install on demand).
node_modules/

# Build artifacts — server bundle (tsdown) + client bundle (vite).
# Produced by `npm run build` (scripts/build-app.sh on the DAB path); shipped
# to the Apps container via DAB sync.include, never committed.
dist/
client/dist/

# Drizzle migrations — a BUILD ARTIFACT regenerated from server/db/schema.ts
# on every dev/build (predev/prebuild + start.sh/build-app.sh run db:generate).
# See drizzle.config.ts header for why it's not committed.
drizzle/

# Local env + secrets. Never commit; .env.template is the checked-in guide.
.env
.env.*
!.env.template
!.env.example

# Dev-server bookkeeping (start.sh) + test/tooling output.
.preview.pgid
.smoke-test/
test-results/
playwright-report/
coverage/

# TS build info.
*.tsbuildinfo

# OS noise.
.DS_Store
