{
  "name": "brightwave-campaign-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/server.ts",
    "sync": "appkit plugin sync --write --silent",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:server": "tsdown -c tsdown.server.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "build:source": "npm run build:server && npm run build:client",
    "build": "echo '[build] using prebuilt dist/ shipped via DAB sync.include (real build runs locally via scripts/build-app.sh -> build:source)'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@databricks/appkit": "^0.66.1",
    "@databricks/appkit-ui": "^0.66.1",
    "@openai/agents": "^0.17.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "mlflow-tracing": "^0.1.3",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.20.3",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
